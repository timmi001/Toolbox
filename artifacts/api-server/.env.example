# AI Provider Configuration
# This file documents all AI provider configuration with current working model IDs
# Copy to .env.local and fill in your actual API keys

# ============================================================================
# CRITICAL: AgentRouter Configuration (PRIMARY AI PROVIDER)
# ============================================================================
# AgentRouter is the primary provider. If this key is not set, the system will
# fall back to Gemini, Groq, and OpenRouter.
#
# Get your API key from: https://agentrouter.org/dashboard

AGENTROUTER_API_KEY=your_agentrouter_api_key_here

# AgentRouter model overrides (optional)
# Default: "auto" (lets AgentRouter select the best model)
# You can override with specific model names if needed
# AGENTROUTER_MODEL_STANDARD=auto
# AGENTROUTER_MODEL_COMPLEX=auto

# AgentRouter API endpoint (optional, rarely needs to change)
# Default: https://co.agentrouter.org/v1
# AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1

# ============================================================================
# Gemini Configuration (FALLBACK #1)
# ============================================================================
# Get your API key from: https://aistudio.google.com/apikey
# Supports both GEMINI_API_KEY and GOOGLE_API_KEY as aliases

GEMINI_API_KEY=your_gemini_api_key_here
# Alternatively, use:
# GOOGLE_API_KEY=your_google_api_key_here

# Gemini model IDs (currently available, regularly updated by Google)
# Default model: gemini-2.5-flash (standard and complex)
#
# CURRENTLY AVAILABLE GEMINI MODELS:
#   - gemini-2.5-flash
#   - gemini-2.5-pro
#   - gemini-2.5-flash-lite
#
# GEMINI_MODEL_STANDARD=gemini-2.5-flash
# GEMINI_MODEL_COMPLEX=gemini-2.5-flash

# ============================================================================
# Groq Configuration (FALLBACK #2)
# ============================================================================
# Get your API key from: https://console.groq.com/keys
# Groq offers high-speed inference with lower latency and rate limits

GROQ_API_KEY=your_groq_api_key_here

# Groq model IDs (currently available)
# Default: openai/gpt-oss-20b
# Complex tasks use openai/gpt-oss-120b.
#
# GROQ_MODEL_STANDARD=openai/gpt-oss-20b
# GROQ_MODEL_COMPLEX=openai/gpt-oss-120b

# ============================================================================
# OpenRouter Configuration (FALLBACK #3)
# ============================================================================
# Get your API key from: https://openrouter.ai/keys
# OpenRouter provides access to multiple AI models through a unified API

OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter model IDs (currently available)
# Defaults: openai/gpt-oss-20b and openai/gpt-oss-120b
#
# CURRENTLY AVAILABLE MODELS ON OPENROUTER:
#   - openai/gpt-oss-20b
#   - openai/gpt-oss-120b
#
# OPENROUTER_MODEL_STANDARD=openai/gpt-oss-20b
# OPENROUTER_MODEL_COMPLEX=openai/gpt-oss-120b

# OpenRouter custom headers (recommended)
# OPENROUTER_SITE_URL=https://toolbuxx.site
# OPENROUTER_SITE_NAME=ToolboXX

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

PORT=3000

# Public site URL (used in OpenRouter headers for identification)
PUBLIC_SITE_URL=https://toolbuxx.site

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
# 
# Provider Fallback Order:
# 1. AgentRouter (PRIMARY) — if configured
# 2. Gemini (FALLBACK #1) — if AgentRouter fails or is not configured
# 3. Groq (FALLBACK #2) — if Gemini also fails
# 4. OpenRouter (FALLBACK #3) — if all others fail
#
# Rate Limits & Timeouts:
#   - Standard requests: 30 seconds timeout
#   - Complex requests: 60 seconds timeout
#   - Automatic retry (2x) for transient network errors
#   - Falls back to next provider on: 404, 429, 5xx, timeout, network error
#
# Production Recommendations:
#   1. Set AGENTROUTER_API_KEY for the primary provider
#   2. Set at least one fallback provider (Gemini recommended)
#   3. Monitor logs to track which provider is being used
#   4. Update model IDs if you see "model_not_found" errors
#   5. Test the /ai/generate endpoint after deployment
#
# Model Retirement Handling:
#   When a model is retired (404 error), the system will:
#   1. Log the model_not_found error
#   2. Fall back to the next provider
#   3. Try again with that provider's model
#
#   To fix retired models:
#   - Update the default model ID in src/lib/ai-service.ts
#   - Or set the environment variable to override the default
#
# Debugging:
#   Enable debug logging to see provider attempts:
#   - Check render.com logs for provider selection details
#   - Look for "[ai-service]" prefixed log messages
#   - Each provider attempt includes: provider name, model, error reason, duration
