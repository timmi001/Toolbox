{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "rm -rf artifacts/utility-tools/dist && pnpm --filter @workspace/utility-tools run build",
  "outputDirectory": "artifacts/utility-tools/dist/public",
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain" },
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/.*$", "dest": "/index.html" }
  ]
}
